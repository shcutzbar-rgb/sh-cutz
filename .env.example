# Kopiera till .env.local (Next.js dev) och .dev.vars (Cloudflare preview).
# Lägg aldrig riktiga nycklar i denna fil.

# --- Sajt ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE=Europe/Stockholm

# --- Supabase (Project settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Endast server. Får aldrig exponeras i klientkod eller checkas in.
SUPABASE_SECRET_KEY=your-secret-key

# --- Brevo (transaktionsmejl) ---
BREVO_API_KEY=xkeysib-your-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=SH-Cutz

# --- Schemalagda påminnelser: krävs för /api/cron/reminders (se README) ---
CRON_SECRET=change-me

# --- Cloudflare Turnstile (bot-skydd på bokning, avbokning och login) ---
# Skapa en widget i Cloudflare-dashboarden (Turnstile). I produktion blockeras formulären utan secret.
# Testnycklar som alltid godkänner: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# --- Sentry (felspårning, valfritt) ---
# Utan SENTRY_DSN är felrapportering avstängd. Sätt som secret: wrangler secret put SENTRY_DSN
SENTRY_DSN=
SENTRY_ENVIRONMENT=production