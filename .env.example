# Kopiera till .env.local (Next.js dev) och .dev.vars (Cloudflare preview).
# Lägg aldrig riktiga nycklar i denna fil.

# --- Sajt ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE=Europe/Stockholm

# --- Supabase (Project settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Endast server. Får aldrig exponeras i klientkod.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Resend (e-post) ---
RESEND_API_KEY=re_your_api_key
# Avsändaradress på en verifierad domän i Resend
EMAIL_FROM="SH-Cutz <bokning@example.com>"

# --- Valfritt: schemalagda påminnelser (Fas 4) ---
CRON_SECRET=change-me
